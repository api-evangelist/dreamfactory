                "description": "Number of records to skip for pagination."
              }
            ]
          },
          "docs": "Retrieve a list of application groups."
        },
        {
          "info": {
            "name": "DreamFactory Create application group",
            "type": "http"
          },
          "http": {
            "method": "POST",
